var assert = require('chai').assert;
describe('Array', function() {
  describe('#indexOf()', function () {
    it('should return 1 when the value is 1 present', function () {
      assert.equal(1, [1, 1].indexOf(0,1));
      assert.equal(1, [1, 0].indexOf(0,1));
      assert.equal(1, [0, 1].indexOf(0,1));
      assert.equal(0, [0, 0].indexOf(0,1));
    });
  });
});



